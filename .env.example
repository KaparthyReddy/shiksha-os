# --- Database (superuser for migrations, restricted role for the app so RLS is enforced) ---
DATABASE_ADMIN_URL=postgres://shiksha:shiksha@localhost:5432/shiksha
DATABASE_URL=postgres://shiksha_app:shiksha_app@localhost:5432/shiksha

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# --- API / Web ---
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Live classes (self-hosted LiveKit, dev keys) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret

# --- Storage: local | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY=

# --- Email (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Local AI (Ollama runs on your host, not in Docker) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
