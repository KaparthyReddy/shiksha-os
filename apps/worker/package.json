{
  "name": "@shiksha/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "once": "tsx --env-file=../../.env src/run-once.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shiksha/core": "workspace:*",
    "@shiksha/db": "workspace:*",
    "@shiksha/pdf": "workspace:^",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@shiksha/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
